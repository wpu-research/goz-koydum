{
  "expo": {
    "name": "Göz Koydum",
    "slug": "goz-koydum",
    "version": "1.0.0",
    "scheme": "gozkoydum",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#241F38"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Beğendiğin ürünlerin fotoğrafını çekmek için kamera gerekli.",
        "NSPhotoLibraryUsageDescription": "Screenshot ve ürün fotoğraflarını seçmek için galeri erişimi gerekli.",
        "NSLocationWhenInUseUsageDescription": "Mağazadaki ürünün konumunu otomatik kaydetmek için konum gerekli."
      }
    },
    "android": {
      "package": "com.gozkoydum.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#241F38"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-location",
      "expo-image-picker",
      "expo-asset",
      "expo-notifications",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["image/*"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          }
        }
      ]
    ]
  }
}
